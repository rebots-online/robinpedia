{
    // Java configuration for multiple JDK support
    "java.configuration.runtimes": [
        {
            "name": "JavaSE-21",
            "path": "/usr/lib/jvm/temurin-21-jdk-amd64",
            "default": true
        },
        {
            "name": "JavaSE-17",
            "path": "/usr/lib/jvm/java-17-openjdk-amd64"
        }
    ],
    
    // Java settings that help with mixed version projects
    "java.jdt.ls.java.home": "/usr/lib/jvm/temurin-21-jdk-amd64",
    "java.import.gradle.java.home": "/usr/lib/jvm/java-17-openjdk-amd64",
    "java.configuration.updateBuildConfiguration": "automatic",
    
    // Recommended Java extension settings
    "java.completion.importOrder": [
        "java",
        "javax",
        "org",
        "com"
    ],
    "java.cleanup.actionsOnSave": [
        "qualifyMembers",
        "addOverride"
    ],
    "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
    "java.format.settings.profile": "GoogleStyle"
}